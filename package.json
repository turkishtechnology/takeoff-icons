{
  "name": "tk-icons",
  "version": "0.0.1",
  "description": "Production-grade icon library monorepo for the @tk-icons/* packages.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkishtechnology/tk-icons.git"
  },
  "bugs": {
    "url": "https://github.com/turkishtechnology/tk-icons/issues"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "figma:export": "tsx scripts/figma-export.ts",
    "figma:metadata": "tsx scripts/figma-export.ts --metadata-only",
    "optimize": "tsx scripts/optimize.ts",
    "validate": "tsx scripts/validate.ts",
    "generate:metadata": "tsx scripts/generate-metadata.ts",
    "generate:core": "tsx scripts/generate-core.ts",
    "generate:react": "tsx scripts/generate-react.ts",
    "generate:vue": "tsx scripts/generate-vue.ts",
    "generate:sprite": "tsx scripts/generate-sprite.ts",
    "generate:font": "tsx scripts/generate-font.ts",
    "generate": "pnpm optimize && pnpm validate && pnpm generate:metadata && pnpm generate:core && pnpm generate:react && pnpm generate:vue && pnpm generate:sprite && pnpm generate:font",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules",
    "prepublish": "pnpm generate && pnpm build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@tk-icons/eslint-config": "workspace:^",
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "change-case": "^5.4.4",
    "eslint": "^8.57.1",
    "fantasticon": "^3.0.0",
    "glob": "^11.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "rimraf": "^6.0.1",
    "svgo": "^3.3.2",
    "svgson": "^5.3.1",
    "tsx": "4.20.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "yaml": "^2.6.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,html,json,md,yaml,yml}": "prettier --write"
  }
}
