{
  "name": "@tk-icons/vue",
  "version": "0.0.1",
  "description": "Typed Vue 3 components for the tk-icons icon library.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/turkishtechnology/tk-icons/tree/main/packages/icons-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkishtechnology/tk-icons.git",
    "directory": "packages/icons-vue"
  },
  "bugs": {
    "url": "https://github.com/turkishtechnology/tk-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "tk-icons",
    "turkish-technology",
    "vue",
    "vue3",
    "components"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && rimraf dist && mkdir -p dist && cp -R src/. dist/",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "@tk-icons/core": "workspace:*",
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "sideEffects": false
}
