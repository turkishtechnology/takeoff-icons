{
  "name": "@takeoff-icons/vue",
  "version": "0.2.0",
  "description": "Typed Vue 3 components for the takeoff-icons icon library.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/turkishtechnology/takeoff-icons/tree/main/packages/icons-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkishtechnology/takeoff-icons.git",
    "directory": "packages/icons-vue"
  },
  "bugs": {
    "url": "https://github.com/turkishtechnology/takeoff-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "takeoff-icons",
    "turkish-technology",
    "vue",
    "vue3",
    "components"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vue-tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "devDependencies": {
    "@takeoff-icons/core": "workspace:*",
    "typescript": "^5.7.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.10"
  },
  "sideEffects": false
}
