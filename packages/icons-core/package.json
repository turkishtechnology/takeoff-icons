{
  "name": "@tk-icons/core",
  "version": "0.0.1",
  "description": "Framework-agnostic core for tk-icons: icon data, metadata, aliases, and search index.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/turkishtechnology/tk-icons/tree/main/packages/icons-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkishtechnology/tk-icons.git",
    "directory": "packages/icons-core"
  },
  "bugs": {
    "url": "https://github.com/turkishtechnology/tk-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "tk-icons",
    "turkish-technology",
    "metadata",
    "icon-data"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./metadata": {
      "types": "./dist/metadata.d.ts",
      "import": "./dist/metadata.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "sideEffects": false
}
