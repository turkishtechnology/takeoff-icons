{
  "name": "@takeoff-icons/wc",
  "version": "0.0.1",
  "description": "Framework-agnostic <takeoff-icon> web component for the takeoff-icons icon library, built with Stencil.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/turkishtechnology/takeoff-icons/tree/main/packages/icons-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/turkishtechnology/takeoff-icons.git",
    "directory": "packages/icons-web"
  },
  "bugs": {
    "url": "https://github.com/turkishtechnology/takeoff-icons/issues"
  },
  "keywords": [
    "icons",
    "svg",
    "icon-library",
    "takeoff-icons",
    "turkish-technology",
    "web-components",
    "custom-elements",
    "stencil"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "collection": "dist/collection/collection-manifest.json",
  "types": "dist/types/components.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/takeoff-icon": {
      "types": "./dist/components/takeoff-icon.d.ts",
      "import": "./dist/components/takeoff-icon.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --dev --watch --esm",
    "test": "stencil test --spec",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs,.cjs"
  },
  "dependencies": {
    "@takeoff-icons/core": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.20.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0"
  },
  "sideEffects": false
}
